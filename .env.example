# ClassSystem — Environment Configuration Template
# Rename this to .env and fill in your actual credentials

# --- Core App Settings ---
APP_NAME="ClassSystem"
APP_ENV="development" # development | production
APP_URL="http://localhost:8000"
APP_DEBUG=true

# --- Database Credentials ---
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="classystem_db"
DB_USER="root"
DB_PASS=""

# --- Branding & Identity ---
STUDENT_ID_PREFIX="STU"
TEACHER_ID_PREFIX="TCH"

# --- SMTP Configuration ---
# (These can also be managed via Admin Panel)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_NAME="ClassSystem"

# --- SMS & WhatsApp (Optional) ---
# Notify.lk credentials (for standard SMS)
NOTIFY_USER_ID=""
NOTIFY_API_KEY=""
NOTIFY_SENDER_ID="NotifyDemo"

# WhatsApp API Keys (can also be managed via Admin Panel)
WHATSAPP_PROVIDER="none" # none | twilio | ultramsg
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""
WHATSAPP_INSTANCE=""
